# =============================================================================
# AVYLS AI WEBSITE - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# =============================================================================

# =============================================================================
# NODE ENVIRONMENT
# =============================================================================
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000

# =============================================================================
# FIREBASE CONFIGURATION
# =============================================================================
# Firebase Project Settings (from Firebase Console)
FIREBASE_PROJECT_ID=avlys-ai-3e461
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@avlys-ai-3e461.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# AI SERVICE API KEYS
# =============================================================================
# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Mistral AI
MISTRAL_API_KEY=your-mistral-api-key-here

# OpenRouter (for multiple AI providers)
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key-here

# AI ML Image Generation
AI_ML_API_KEY=your-aiml-api-key-here

# FAL AI (for video generation)
FAL_KEY=your-fal-api-key-here

# Replicate (for image/video generation)
REPLICATE_API_TOKEN=r8_your-replicate-token-here

# =============================================================================
# SCRAPER SERVICE CONFIGURATION
# =============================================================================
# Scraper Service Settings
SCRAPER_PORT=8000
SCRAPER_HOST=0.0.0.0
SCRAPER_RELOAD=false

# SerpAPI (for Google search functionality)
SERPAPI_KEY=your-serpapi-key-here

# Groq (for AI insights)
GROQ_API_KEY=gsk_your-groq-api-key-here

# =============================================================================
# PAYMENT PROCESSING (STRIPE)
# =============================================================================
# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MongoDB (if using MongoDB instead of Firestore)
MONGODB_URI=mongodb://localhost:27017/avyls-ai

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# SMTP Settings for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================
# Sentry (for error tracking)
SENTRY_DSN=https://your-sentry-dsn-here

# Google Analytics
GA_TRACKING_ID=G-XXXXXXXXXX

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5001,https://avyls-ai.com

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Debug Mode
DEBUG=true

# Log Level
LOG_LEVEL=info

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
# SSL Configuration
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/key.pem

# CDN Configuration
CDN_URL=https://cdn.avyls-ai.com

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features
ENABLE_AI_CONTENT_GENERATION=true
ENABLE_SCRAPER_SERVICE=true
ENABLE_PAYMENT_PROCESSING=false
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_ANALYTICS=true

# =============================================================================
# NOTES
# =============================================================================
# 1. Never commit your .env file to version control
# 2. Use different API keys for development and production
# 3. Regularly rotate your JWT secrets
# 4. Keep your Firebase private key secure
# 5. Monitor your API usage to avoid rate limits 